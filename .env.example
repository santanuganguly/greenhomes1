# Green Homes — environment template
# Copy this to `.env` and fill in real values.

# Database
GH_DB_HOST=127.0.0.1
GH_DB_PORT=3306
GH_DB_NAME=green_homes
GH_DB_USER=root
GH_DB_PASS=

# App
GH_APP_URL=http://127.0.0.1:8000
GH_APP_ENV=development   # development | production

# Contact details — replace these placeholders with real values.
# Used by header, footer, contact page, and email notifications.
GH_CONTACT_PHONE="+91 9046665257"
GH_CONTACT_EMAIL=contact@thegreen.homes
GH_CONTACT_ADDRESS="5th floor centerio building, near payel cinema hall, Sevoke Road, Siliguri, 734001"

# Notification email recipient (admin). Usually the same as GH_CONTACT_EMAIL.
GH_NOTIFY_TO=contact@thegreen.homes
GH_NOTIFY_FROM="Green Homes <no-reply@thegreen.homes>"

# In development, outgoing mail is appended to storage/mail/ instead of sent.
# Set to "true" to force file logging even in production.
GH_MAIL_LOG_ONLY=true

# Google Sheets Web App API URL for capturing leads, messages, and user activity
GH_GOOGLE_SHEETS_API_URL=
